#!/usr/bin/env python3
"""Hover popup for the panelgraph network graph (F-25, requirements 4.7).

genmon re-sets its tooltip on every poll, which keeps GTK from ever showing it at a
0.25 s period (DEF-06). panelgraph-daemon therefore starts this helper and feeds it
$XDG_RUNTIME_DIR/panelgraph/popup.json. The helper watches the genmon panel item's
socket window for Enter/Leave only, and the wrapper's exit through a pidfd, so panel
redraws and relayouts never wake it while hidden (D-58). While the pointer rests
on the item it shows a small dark override-redirect window, transparent to input, that
lists the graph's strips with their rates.

X is reached through ctypes (libX11, libXext, libXi, libXinerama, libXrandr) and the
text is drawn with pycairo. The helper starts no processes, takes no grabs, never moves
the pointer and never takes focus (D-47 to D-54).
"""
import ctypes
import fcntl
import json
import math
import os
import re
import select
import signal
import stat
import sys
import time
import traceback

# --- identity and lifecycle (D-54) ---
PROC_NAME = "panelgraph-pop"         # /proc/<pid>/comm; never "panelgraph", which counts daemons
EXIT_OK = 0                          # daemon gone or SIGTERM; the daemon may respawn after 5 s
EXIT_CRASH = 1                       # unexpected exception, traceback in popup.log; retry 30 s
EXIT_BUSY = 2                        # another helper holds popup.lock; retry 5 s
EXIT_UNAVAILABLE = 3                 # no display/X libs/usable visual, bad DAEMON_PID; retry 300 s

# --- timing (D-49) ---
SHOW_DELAY = 0.5                     # s of hover before the popup shows, like a GTK tooltip
REFRESH = 0.25                       # s between content and pointer re-checks while shown (SEC-10)
ATTACH_RETRY = 2.0                   # s between panel-item lookups while detached (D-48)
LOG_ONCE_PERIOD = 600                # s between popup.log entries with the same key
POPUP_LOG_MAX = 16384                # B; an append that would pass this restarts popup.log (D-54)
POPUP_LOG_ENTRY_MAX = 4096           # code points per entry; the tail (a traceback's last frames) is kept
LOG_MODE = 0o600                     # popup.log is owner-only, like everything in DIR (F-26)

# --- input limits (SEC-02, SEC-05) ---
HOST_MAX = 32                        # B read from net.host
DOC_MAX = 16384                      # B read from popup.json; larger files are ignored
CMDLINE_MAX = 4096                   # B read from /proc/<pid>/cmdline
XID_MAX = 0x1FFFFFFF                 # X resource ids have 29 bits
COORD_MAX = 32767                    # |x|, |y|, w, h of a PANELGRAPH_POPUP_MONITORS entry
MAX_ROWS = 4                         # rows drawn: "!!" alert + 3 strips
MAX_CELLS = 4                        # cells per row
MAX_SEGS = 4                         # [text, colour] segments per cell
TEXT_MAX = 128                       # code points per segment; the "!!" row is ~86
SURF_MAX_W, SURF_MAX_H = 2048, 512   # px, surface cap before allocation
WRAPPER_NAME = b"wrapper-2.0"        # basename of the xfce4-panel plugin wrapper (argv[0])
GENMON_LIB = b"libgenmon.so"         # argv[1] suffix of a genmon item; argv[3] is its socket XID

# --- look (D-52): fixed dark colours, theme-independent and testable ---
BG = "1C1C1E"                        # popup background
BORDER = "3A3A3C"                    # border colour
BORDER_W = 1                         # px popup border (D-52)
TEXT = "E6E6E6"                      # text without a glyph colour
GLYPH_COLORS = frozenset({"FF4F00", "FFE500", "FF00FF", "FFA0FF"})   # the graph's four, never FF2020
FONT_FACE = "DejaVu Sans"            # cairo toy face; fontconfig substitutes when missing
FONT_PX = 13                         # font size at 96 dpi
PAD_X, PAD_Y = 10, 6                 # px padding at 96 dpi
COL_GAP = 14                         # px between cells at 96 dpi
LINE_GAP = 3                         # px between rows at 96 dpi
RADIUS = 6                           # px corner radius at 96 dpi
GAP = 4                              # px between the panel item and the popup (D-53)
MARGIN = 4                           # px the popup keeps from the monitor edges (D-53)
DPI_DEFAULT, DPI_MIN, DPI_MAX = 96.0, 72.0, 288.0   # Xft.dpi fallback and clamp (kali-hidpi-mode)

# --- states (D-49) ---
DETACHED, IDLE, PENDING, SHOWN, SUPPRESSED = "detached", "idle", "pending", "shown", "suppressed"

# --- env hooks, read once; validated where they are used (requirements 4.0) ---
POPUP_XID_ENV = os.environ.get("PANELGRAPH_POPUP_XID")          # sandbox: target window, skips net.host
MONITORS_ENV = os.environ.get("PANELGRAPH_POPUP_MONITORS")      # sandbox: "x,y,w,h;..." monitor override
DAEMON_PID_ENV = os.environ.get("PANELGRAPH_DAEMON_PID")        # set by panelgraph-daemon

# --- runtime dir (D-55): these lines and secure_dir() are byte-identical in panelgraph-daemon ---
DIR_MODE = 0o700                     # runtime dir is owner-only (F-26)
UMASK = 0o077                        # every file we create is owner-only too
_XDG = os.environ.get("XDG_RUNTIME_DIR") or ""
DIR = os.path.join(_XDG, "panelgraph") if os.path.isabs(_XDG) else None
# --- end of the D-55 block ---
POPUP_PID, POPUP_LOCK, POPUP_LOG, POPUP_JSON, NET_HOST = (
    tuple(os.path.join(DIR, n) for n in ("popup.pid", "popup.lock", "popup.log", "popup.json", "net.host"))
    if DIR else (None,) * 5)

# --- Xlib protocol constants (X.h, XI2.h, shape.h, prctl.h), named for the AC-92 static gate ---
EnterWindowMask = 1 << 4
LeaveWindowMask = 1 << 5
StructureNotifyMask = 1 << 17
NoEventMask = 0                      # X: deselect a foreign window (D-58)
EnterNotify, LeaveNotify, DestroyNotify, UnmapNotify, ConfigureNotify = 7, 8, 17, 18, 22
# Hidden, only crossings: StructureNotify would wake us on every panel relayout (D-58).
ITEM_MASK_HIDDEN = EnterWindowMask | LeaveWindowMask
ITEM_MASK_SHOWN = ITEM_MASK_HIDDEN | StructureNotifyMask   # shown: re-place on moves, see the item go
GenericEvent = 35
NotifyGrab = 1                       # crossing mode
NotifyInferior = 2                   # crossing detail
InputOutput = 1
CWBackPixel, CWBorderPixel, CWOverrideRedirect = 1 << 1, 1 << 3, 1 << 9
ZPixmap = 2
LSBFirst, MSBFirst = 0, 1
HOST_BYTE_ORDER = LSBFirst if sys.byteorder == "little" else MSBFirst   # cairo pixels are native
TrueColor = 4
RGB_MASKS = (0xFF0000, 0x00FF00, 0x0000FF)   # the only visual layout cairo RGB24 matches (SEC-03)
IMAGE_BPP = 32
PropModeReplace = 0
PROP_FORMAT_8 = 8
PROP_FORMAT_32 = 32                  # XChangeProperty element sizes, bits
XA_ATOM, XA_STRING = 4, 31
ShapeBounding, ShapeInput = 0, 2
ShapeSet = 0
Unsorted = 0
XIAllMasterDevices = 1
XI_RawButtonPress = 15
XI_MASK_LEN = 4                      # XIMaskLen(XI_LASTEVENT)
XI_VERSION = (2, 2)                  # raw events also arrive while another client grabs
PR_SET_PDEATHSIG = 1
X_SUCCESS = 0

c_int, c_uint, c_long, c_ulong = ctypes.c_int, ctypes.c_uint, ctypes.c_long, ctypes.c_ulong
c_void_p, c_char_p, c_short, c_ushort = ctypes.c_void_p, ctypes.c_char_p, ctypes.c_short, ctypes.c_ushort
P = ctypes.POINTER


# --- Xlib structures (Xlib.h, Xinerama.h, Xrandr.h, XInput2.h) ---
class XAnyEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int), ("display", c_void_p),
                ("window", c_ulong)]


class XCrossingEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int), ("display", c_void_p),
                ("window", c_ulong), ("root", c_ulong), ("subwindow", c_ulong), ("time", c_ulong),
                ("x", c_int), ("y", c_int), ("x_root", c_int), ("y_root", c_int),
                ("mode", c_int), ("detail", c_int), ("same_screen", c_int), ("focus", c_int),
                ("state", c_uint)]


class XConfigureEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int), ("display", c_void_p),
                ("event", c_ulong), ("window", c_ulong), ("x", c_int), ("y", c_int),
                ("width", c_int), ("height", c_int), ("border_width", c_int), ("above", c_ulong),
                ("override_redirect", c_int)]


class XGenericEventCookie(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int), ("display", c_void_p),
                ("extension", c_int), ("evtype", c_int), ("cookie", c_uint), ("data", c_void_p)]


class XEvent(ctypes.Union):
    _fields_ = [("type", c_int), ("xany", XAnyEvent), ("xcrossing", XCrossingEvent),
                ("xconfigure", XConfigureEvent), ("xcookie", XGenericEventCookie),
                ("pad", c_long * 24)]


class XErrorEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("display", c_void_p), ("resourceid", c_ulong), ("serial", c_ulong),
                ("error_code", ctypes.c_ubyte), ("request_code", ctypes.c_ubyte),
                ("minor_code", ctypes.c_ubyte)]


class Visual(ctypes.Structure):
    _fields_ = [("ext_data", c_void_p), ("visualid", c_ulong), ("class_", c_int),
                ("red_mask", c_ulong), ("green_mask", c_ulong), ("blue_mask", c_ulong),
                ("bits_per_rgb", c_int), ("map_entries", c_int)]


class XPixmapFormatValues(ctypes.Structure):
    _fields_ = [("depth", c_int), ("bits_per_pixel", c_int), ("scanline_pad", c_int)]


class XImageHead(ctypes.Structure):
    """The leading fields of XImage: enough to hand our buffer back before XFree."""
    _fields_ = [("width", c_int), ("height", c_int), ("xoffset", c_int), ("format", c_int),
                ("data", c_void_p), ("byte_order", c_int)]


class XWindowAttributes(ctypes.Structure):
    _fields_ = [("x", c_int), ("y", c_int), ("width", c_int), ("height", c_int),
                ("border_width", c_int), ("depth", c_int), ("visual", c_void_p), ("root", c_ulong),
                ("class_", c_int), ("bit_gravity", c_int), ("win_gravity", c_int),
                ("backing_store", c_int), ("backing_planes", c_ulong), ("backing_pixel", c_ulong),
                ("save_under", c_int), ("colormap", c_ulong), ("map_installed", c_int),
                ("map_state", c_int), ("all_event_masks", c_long), ("your_event_mask", c_long),
                ("do_not_propagate_mask", c_long), ("override_redirect", c_int), ("screen", c_void_p)]


class XSetWindowAttributes(ctypes.Structure):
    _fields_ = [("background_pixmap", c_ulong), ("background_pixel", c_ulong),
                ("border_pixmap", c_ulong), ("border_pixel", c_ulong), ("bit_gravity", c_int),
                ("win_gravity", c_int), ("backing_store", c_int), ("backing_planes", c_ulong),
                ("backing_pixel", c_ulong), ("save_under", c_int), ("event_mask", c_long),
                ("do_not_propagate_mask", c_long), ("override_redirect", c_int),
                ("colormap", c_ulong), ("cursor", c_ulong)]


class XRectangle(ctypes.Structure):
    _fields_ = [("x", c_short), ("y", c_short), ("width", c_ushort), ("height", c_ushort)]


class XineramaScreenInfo(ctypes.Structure):
    _fields_ = [("screen_number", c_int), ("x_org", c_short), ("y_org", c_short),
                ("width", c_short), ("height", c_short)]


class XRRMonitorInfo(ctypes.Structure):
    _fields_ = [("name", c_ulong), ("primary", c_int), ("automatic", c_int), ("noutput", c_int),
                ("x", c_int), ("y", c_int), ("width", c_int), ("height", c_int),
                ("mwidth", c_int), ("mheight", c_int), ("outputs", c_void_p)]


class XIEventMask(ctypes.Structure):
    _fields_ = [("deviceid", c_int), ("mask_len", c_int), ("mask", P(ctypes.c_ubyte))]


XErrorHandler = ctypes.CFUNCTYPE(c_int, c_void_p, P(XErrorEvent))
XIOErrorHandler = ctypes.CFUNCTYPE(c_int, c_void_p)

# --- the one declaration table: (soname, required, ((name, restype, *argtypes), ...)) (SEC-03) ---
